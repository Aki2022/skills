#!/usr/bin/env sh
# vibe-guard pre-push.d extension. Its first argument is the preserved refs file.
set -eu
repo=$(git rev-parse --show-toplevel) || exit 2
marker="$repo/.vibe-guard/design-ship.enabled"
[ -e "$marker" ] || exit 0
[ -f "$marker" ] && [ ! -L "$marker" ] && [ "$(cat "$marker")" = "1" ] || {
  echo 'invalid design ship marker; shipment stopped' >&2
  exit 2
}
exec "${DESIGN_SHIP_COMMAND:-design-ship}" --repo "$repo"

#!/usr/bin/env sh
# vibe-guard passes the preserved refs file after its scanner has consumed stdin.
# Every repository with a design system (design/design.yaml) is checked; no per-repo opt-in is needed.
# The legacy marker may remain but cannot disable the gate: anything other than "1" stops the push.
set -eu
repo=$(git rev-parse --show-toplevel) || exit 2
marker="$repo/.vibe-guard/design-ship.enabled"
if [ -e "$marker" ] || [ -L "$marker" ]; then
  [ -f "$marker" ] && [ ! -L "$marker" ] && [ "$(cat "$marker")" = "1" ] || {
    echo 'invalid design ship marker; shipment stopped' >&2
    exit 2
  }
elif [ ! -e "$repo/design/design.yaml" ] && [ ! -L "$repo/design/design.yaml" ]; then
  exit 0
fi
[ "$#" -eq 1 ] && [ -f "$1" ] || {
  echo 'missing preserved push refs; shipment stopped' >&2
  exit 2
}
exec "${DESIGN_SHIP_COMMAND:-design-ship}" --repo "$repo" --pre-push --refs-file "$1"

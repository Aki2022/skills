#!/usr/bin/env sh
# vibe-guard passes the preserved refs file after its scanner has consumed stdin.
# Every repository with a design system (found by design-ship --probe) is checked; no per-repo opt-in is needed.
# The legacy marker may remain but cannot disable the gate: anything other than "1" stops the push.
set -eu
repo=$(git rev-parse --show-toplevel) || exit 2
marker="$repo/.vibe-guard/design-ship.enabled"
if [ -e "$marker" ] || [ -L "$marker" ]; then
  [ -f "$marker" ] && [ ! -L "$marker" ] && [ "$(cat "$marker")" = "1" ] || {
    echo 'invalid design ship marker; shipment stopped' >&2
    exit 2
  }
else
  # Whether a design system is present (and whether its layout is readable) is design-ship's to say, so the
  # place stays the rule's: 0 present, 3 none (nothing to check), anything else (a layout it cannot read) stops.
  ship="${DESIGN_SHIP_COMMAND:-design-ship}"
  rc=0
  "$ship" --probe --repo "$repo" || rc=$?
  case "$rc" in
    0) ;;
    3) exit 0 ;;
    *)
      echo 'design layout probe failed; shipment stopped' >&2
      exit 2
      ;;
  esac
fi
[ "$#" -eq 1 ] && [ -f "$1" ] || {
  echo 'missing preserved push refs; shipment stopped' >&2
  exit 2
}
exec "${DESIGN_SHIP_COMMAND:-design-ship}" --repo "$repo" --pre-push --refs-file "$1"

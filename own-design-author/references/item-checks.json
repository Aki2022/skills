{
  "schema_version": 1,
  "comment": "Skill-owned map from catalog items to code checks, shared by every repository. An item routes to machine only when every listed checker is active; otherwise it falls back to AFM. 'applicability' lists selectors that show a component is on a rendered page; a page without any of them makes the component's items not applicable there. A document absent from 'applicability' is always applicable.",
  "applicability": {
    "components/accordion": ["details", "[aria-expanded][aria-controls]"],
    "components/blockquote": ["blockquote"],
    "components/breadcrumb": ["nav[aria-label*='パンくず']", "nav[aria-label*='breadcrumb' i]"],
    "components/button": ["button", "[role='button']", "input[type='button']", "input[type='submit']", "input[type='reset']"],
    "components/carousel": ["[aria-roledescription='carousel']"],
    "components/checkbox": ["input[type='checkbox']", "[role='checkbox']"],
    "components/combobox": ["[role='combobox']", "input[list]"],
    "components/date-picker": ["input[type='date']"],
    "components/description-list": ["dl"],
    "components/disclosure": ["details", "[aria-expanded][aria-controls]"],
    "components/divider": ["hr", "[role='separator']"],
    "components/file-upload": ["input[type='file']"],
    "components/hamburger-menu-button": ["button[aria-expanded][aria-controls]"],
    "components/header-container": ["header", "[role='banner']"],
    "components/heading": ["h1", "h2", "h3", "h4", "h5", "h6", "[role='heading']"],
    "components/horizontal-menu": ["nav"],
    "components/image": ["img", "picture", "svg[role='img']"],
    "components/input-text": ["input:not([type])", "input[type='text']", "input[type='email']", "input[type='tel']", "input[type='url']", "input[type='number']", "input[type='password']", "input[type='search']"],
    "components/list": ["ul", "ol"],
    "components/menu-list": ["[role='menu']", "nav ul"],
    "components/menu-list-box": ["[role='listbox']"],
    "components/modal-dialog": ["dialog", "[role='dialog']", "[aria-modal='true']"],
    "components/notification-banner": ["[role='alert']", "[role='status']"],
    "components/progress-indicator": ["progress", "[role='progressbar']"],
    "components/radio": ["input[type='radio']", "[role='radio']"],
    "components/search-box": ["input[type='search']", "[role='search']", "search"],
    "components/select": ["select"],
    "components/switch": ["[role='switch']"],
    "components/tab": ["[role='tablist']"],
    "components/table": ["table"],
    "components/table-control": ["table"],
    "components/textarea": ["textarea"]
  },
  "checks": [
    {"document": "foundations/color", "headings": ["キーカラー", "共通カラー", "機能カラー", "アクセントカラー", "セマンティックカラー", "プリミティブカラー", "ニュートラルカラー"], "checkers": ["palette:color"]},
    {"document": "foundations/color", "headings": ["コントラスト要件", "前景色（テキストのカラー）と背景色の両方を指定する"], "checkers": ["contrast"]},
    {"document": "foundations/corner-shapes", "headings": ["角の形状とサイズ"], "checkers": ["palette:radius"]},
    {"document": "foundations/elevation", "headings": ["エレベーションの表現", "ドロップシャドウとエレベーション", "高さレベルの高低差", "固有の高さのレベル", "高さレベルの基準", "ダークモードのエレベーション"], "checkers": ["palette:shadow"]},
    {"document": "foundations/layout", "headings": ["ブレークポイント", "リキッドレイアウトを採用する"], "checkers": ["layout-overflow"]},
    {"document": "foundations/link-text", "headings": ["リンクカラー（リンクテキストの色）"], "checkers": ["palette:color"]},
    {"document": "foundations/link-text", "headings": ["ターゲットサイズの確保"], "checkers": ["tap-target"]},
    {"document": "foundations/link-text", "headings": ["「ここ」や「こちら」をリンクテキストにしない"], "checkers": ["dom:vague-link-text"]},
    {"document": "foundations/spacing", "headings": ["余白の種類", "余白のルールの考え方", "余白ルールの例"], "checkers": ["palette:spacing"]},
    {"document": "foundations/spacing", "headings": ["空白や両端揃えを使ってレイアウトを調整しない"], "checkers": ["dom:text-justify"]},
    {"document": "foundations/typography", "headings": ["フォントファミリー（`font-family`）"], "checkers": ["palette:fontFamily"]},
    {"document": "foundations/typography", "headings": ["書体の太さ（`font-weight`）"], "checkers": ["palette:fontWeight"]},
    {"document": "foundations/typography", "headings": ["書体の大きさ（`font-size`）"], "checkers": ["palette:fontSize"]},
    {"document": "foundations/typography", "headings": ["テキストスタイル名の構成", "テキストスタイルの種類", "Display (Dsp)", "Standard (Std)", "Dense (Dns)", "Oneline (Oln)", "Mono"], "checkers": ["palette:fontSize", "palette:fontWeight"]},
    {"document": "components/button", "headings": ["コントラスト要件"], "checkers": ["contrast"]},
    {"document": "components/button", "headings": ["ラベルがアイコンだけのボタンに代替テキストを必ず指定する"], "checkers": ["axe:button-name"]},
    {"document": "components/button", "headings": ["ボタンのフォーカス順序と表示順序に気をつける"], "checkers": ["dom:positive-tabindex"]},
    {"document": "components/button", "headings": ["ターゲットサイズの確保"], "checkers": ["tap-target"]},
    {"document": "components/heading", "headings": ["見出しレベルを飛ばさない"], "checkers": ["heading-order"]},
    {"document": "components/input-text", "headings": ["プレースホルダーテキストを使わない"], "checkers": ["dom:placeholder"]},
    {"document": "components/input-text", "headings": ["無効フィールド（`disabled`）を使わない"], "checkers": ["dom:disabled-input"]},
    {"document": "components/input-text", "headings": ["編集不可フィールド（`readonly`）を使わない"], "checkers": ["dom:readonly-input"]},
    {"document": "components/input-text", "headings": ["最大長の制限に`maxlength`属性を使用しない"], "checkers": ["dom:maxlength"]},
    {"document": "components/list", "headings": ["`<ol>`要素は使わず、`<ul>`要素として実装する"], "checkers": ["dom:ol"]},
    {"document": "components/list", "headings": ["適切な入れ子としてマークアップする"], "checkers": ["axe:list"]},
    {"document": "components/date-picker", "headings": ["`<select>`要素および`<input type=\"date\">`要素の使用を避ける"], "checkers": ["dom:date-input"]},
    {"document": "components/table", "headings": ["シンプルな構造で作る"], "checkers": ["dom:table-span"]}
  ]
}

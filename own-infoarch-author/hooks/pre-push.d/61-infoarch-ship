#!/usr/bin/env sh
# vibe-guard passes the preserved refs file after its scanner has consumed stdin.
# Opt-in per repository through .vibe-guard/infoarch-ship.enabled; once enabled, every failure stops the push.
set -eu
repo=$(git rev-parse --show-toplevel) || exit 2
marker="$repo/.vibe-guard/infoarch-ship.enabled"
[ -e "$marker" ] || [ -L "$marker" ] || exit 0
[ -f "$marker" ] && [ ! -L "$marker" ] && [ "$(cat "$marker")" = "1" ] || {
  echo 'invalid IA ship marker; shipment stopped' >&2
  exit 2
}
[ "$#" -eq 1 ] && [ -f "$1" ] || {
  echo 'missing preserved push refs; shipment stopped' >&2
  exit 2
}
exec "${INFOARCH_SHIP_COMMAND:-infoarch-author}" ship --root "$repo" --pre-push --refs-file "$1"

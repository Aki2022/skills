{
  "version": 1,
  "note": "数値トークンのうち主張候補から外すものの表。ここに無い数値トークンは全て主張候補（アンカーが無ければ失格）。正規化（NFKC・dash・wave）後のテキストに Python re で当てる。誤検出が出たら行を足し、足した行には必ず赤と緑のフィクスチャを付ける。表に無いことを理由に合格させない。",
  "patterns": [
    {"id": "url", "regex": "https?://[^\\s\"'<>]+", "why": "URL 内の数字"},
    {"id": "email", "regex": "[\\w.+-]+@[\\w-]+(?:\\.[\\w-]+)+", "why": "メールアドレス内の数字"},
    {"id": "date-ymd", "regex": "\\d{4}\\s*[年/.-]\\s*\\d{1,2}\\s*[月/.-]\\s*\\d{1,2}\\s*日?", "why": "年月日"},
    {"id": "date-ym", "regex": "\\d{4}\\s*年\\s*\\d{1,2}\\s*月", "why": "年月"},
    {"id": "date-md", "regex": "\\d{1,2}\\s*月\\s*\\d{1,2}\\s*日", "why": "月日"},
    {"id": "era-year", "regex": "(?:令和|平成|昭和)\\s*(?:\\d{1,2}|元)\\s*年(?:度)?", "why": "和暦の年"},
    {"id": "western-year", "regex": "(?<!\\d)(?:19|20)\\d{2}\\s*年(?:度)?(?!\\s*(?:間|分|以上|以下|未満))", "why": "西暦の年（「年間」「年分」は期間なので外さない）"},
    {"id": "month-only", "regex": "(?<!\\d)\\d{1,2}\\s*月(?!\\s*(?:額|々|間))", "why": "月（「月額」「か月」は外さない）"},
    {"id": "clock", "regex": "(?<!\\d)\\d{1,2}:\\d{2}(?::\\d{2})?", "why": "時刻"},
    {"id": "clock-ja", "regex": "(?<!\\d)\\d{1,2}\\s*時(?!\\s*間)(?:\\s*\\d{1,2}\\s*分)?", "why": "時刻（「時間」は期間なので外さない）"},
    {"id": "phone", "regex": "(?<!\\d)0\\d{1,4}-\\d{1,4}-\\d{3,4}(?!\\d)", "why": "電話番号"},
    {"id": "postal", "regex": "〒?\\s*(?<!\\d)\\d{3}-\\d{4}(?!\\d)", "why": "郵便番号"},
    {"id": "version", "regex": "(?:[vV]\\s?\\d+(?:\\.\\d+){0,3}|(?<![\\d.])\\d+\\.\\d+\\.\\d+(?![\\d.]))", "why": "版番号"},
    {"id": "step", "regex": "(?:STEP|Step|step|ステップ|手順|Phase|フェーズ)\\s*\\d+", "why": "手順番号"},
    {"id": "chapter", "regex": "第\\s*\\d+\\s*(?:章|節|条|項|部|版)", "why": "章立て（「第1位」は主張なので外さない）"},
    {"id": "list-marker", "regex": "(?m)^\\s*\\d+[.)](?=\\s)", "why": "番号付きリストの記号"},
    {"id": "count-structure", "regex": "\\d+\\s*つ\\s*の?\\s*(?:ステップ|ポイント|理由|特長|特徴|機能|メリット|コツ|方法|プラン)", "why": "文書構造の数え上げ（「3つの理由」）"},
    {"id": "copyright", "regex": "(?:©|\\(c\\)|Copyright)\\s*\\d{4}(?:\\s*-\\s*\\d{4})?", "why": "著作権表示"},
    {"id": "footnote", "regex": "(?:※\\s*\\d+|\\[\\d+\\])", "why": "注番号"}
  ]
}

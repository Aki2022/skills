{
  "version": 1,
  "note": "日本語の数値表記を正規化値（value・unit・qualifier）へ解決する表。NFKC の後に適用する。NFKC は 〜/～・ー/−/- を統一しないので dash と wave を別に畳む。",
  "dash_chars": "−‐‑‒–—―－",
  "wave_chars": "〜～",
  "kanji_digits": {"〇": 0, "零": 0, "一": 1, "二": 2, "三": 3, "四": 4, "五": 5, "六": 6, "七": 7, "八": 8, "九": 9},
  "kanji_small_units": {"十": 10, "百": 100, "千": 1000},
  "kanji_large_units": {"万": 10000, "億": 100000000, "兆": 1000000000000},
  "units": [
    {"unit": "円", "aliases": ["円"]},
    {"unit": "%", "aliases": ["%", "パーセント"]},
    {"unit": "%", "aliases": ["割"], "factor": 10},
    {"unit": "社", "aliases": ["社"]},
    {"unit": "人", "aliases": ["人", "名"]},
    {"unit": "件", "aliases": ["件"]},
    {"unit": "個", "aliases": ["個"]},
    {"unit": "回", "aliases": ["回"]},
    {"unit": "倍", "aliases": ["倍"]},
    {"unit": "位", "aliases": ["位"]},
    {"unit": "年", "aliases": ["年"]},
    {"unit": "か月", "aliases": ["ヶ月", "か月", "カ月", "ケ月", "ヵ月", "箇月"]},
    {"unit": "週間", "aliases": ["週間"]},
    {"unit": "日", "aliases": ["日"]},
    {"unit": "時間", "aliases": ["時間"]},
    {"unit": "分", "aliases": ["分"]},
    {"unit": "秒", "aliases": ["秒"]},
    {"unit": "拠点", "aliases": ["拠点"]},
    {"unit": "店舗", "aliases": ["店舗"]},
    {"unit": "自治体", "aliases": ["自治体"]},
    {"unit": "団体", "aliases": ["団体"]},
    {"unit": "校", "aliases": ["校"]},
    {"unit": "台", "aliases": ["台"]},
    {"unit": "本", "aliases": ["本"]},
    {"unit": "枚", "aliases": ["枚"]},
    {"unit": "点", "aliases": ["点"]},
    {"unit": "歳", "aliases": ["歳", "才"]},
    {"unit": "種類", "aliases": ["種類"]},
    {"unit": "言語", "aliases": ["言語"]},
    {"unit": "カ国", "aliases": ["カ国", "か国", "ヶ国", "ヵ国"]},
    {"unit": "GB", "aliases": ["GB"]},
    {"unit": "TB", "aliases": ["TB"]},
    {"unit": "MB", "aliases": ["MB"]}
  ],
  "qualifiers": {
    "gte": {"suffix": ["以上"]},
    "gt": {"suffix": ["超え", "超"]},
    "lte": {"suffix": ["以下"]},
    "lt": {"suffix": ["未満"]},
    "approx": {"prefix": ["約", "およそ", "ほぼ"], "suffix": ["程度", "前後"]},
    "max": {"prefix": ["最大", "最高"]},
    "min": {"prefix": ["最小", "最低", "最短"]},
    "tax_in": {"prefix": ["税込"], "suffix": ["(税込)", "(税込み)"]},
    "tax_ex": {"prefix": ["税抜"], "suffix": ["(税抜)", "(税抜き)", "(税別)"]},
    "monthly": {"prefix": ["月額", "月々"], "suffix": ["/月"]},
    "yearly": {"prefix": ["年額", "年間"], "suffix": ["/年"]},
    "plus": {"suffix": ["+"]}
  }
}

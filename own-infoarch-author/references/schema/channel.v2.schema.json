{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "own-infoarch-author/channel.v2.schema.json",
  "title": "design/info_arch/channels/<media>.yaml schema version 2",
  "description": "成果物の置き場所と出し方の宣言だけ。使うメッセージや順序は持たない（6 段で成果物ごとに決め、アウトラインに書く）。出典: SPEC-information-architecture-standardization v4。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "media", "outputs", "ship"],
  "properties": {
    "schema_version": {"const": 2},
    "media": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "outputs": {"type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"type": "string", "minLength": 1, "not": {"pattern": "^(/|~)|(^|/)\\.\\.(/|$)"}}},
    "ship": {"type": "boolean"},
    "ship_command": {"type": "string", "minLength": 1},
    "viewports": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["name", "width", "height"],
      "properties": {"name": {"type": "string"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}
    }}
  },
  "if": {"properties": {"ship": {"const": true}}},
  "then": {"required": ["ship_command"]}
}

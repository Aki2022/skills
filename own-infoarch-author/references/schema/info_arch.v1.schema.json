{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "own-infoarch-author/info_arch.v1.schema.json",
  "title": "design/info_arch/info_arch.yaml schema version 1",
  "description": "手書きの版 1。出典: SPEC-information-architecture-standardization（Domain Language・Requirements）。state に approved は無い: 承認は署名付き承認台帳だけが表し、このファイルに AI が書ける形で置かない。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ledger", "audiences", "problems", "messages", "claims", "entities"],
  "properties": {
    "schema_version": {"const": 1},
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["next", "tombstones"],
      "properties": {
        "next": {
          "type": "object",
          "additionalProperties": false,
          "required": ["aud", "prb", "msg", "clm", "trm", "ent"],
          "properties": {
            "aud": {"type": "integer", "minimum": 1},
            "prb": {"type": "integer", "minimum": 1},
            "msg": {"type": "integer", "minimum": 1},
            "clm": {"type": "integer", "minimum": 1},
            "trm": {"type": "integer", "minimum": 1},
            "ent": {"type": "integer", "minimum": 1}
          }
        },
        "tombstones": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/anyId"},
          "additionalProperties": {"oneOf": [{"$ref": "#/$defs/anyId"}, {"const": null}]}
        }
      }
    },
    "audiences": {"type": "object", "propertyNames": {"pattern": "^aud-[0-9]{4,}$"}, "additionalProperties": {"$ref": "#/$defs/audience"}},
    "problems": {"type": "object", "propertyNames": {"pattern": "^prb-[0-9]{4,}$"}, "additionalProperties": {"$ref": "#/$defs/problem"}},
    "messages": {"type": "object", "propertyNames": {"pattern": "^msg-[0-9]{4,}$"}, "additionalProperties": {"$ref": "#/$defs/message"}},
    "claims": {"type": "object", "propertyNames": {"pattern": "^clm-[0-9]{4,}$"}, "additionalProperties": {"$ref": "#/$defs/claim"}},
    "entities": {"type": "object", "propertyNames": {"pattern": "^ent-[0-9]{4,}$"}, "additionalProperties": {"$ref": "#/$defs/entity"}}
  },
  "$defs": {
    "anyId": {"type": "string", "pattern": "^(aud|prb|msg|clm|trm|ent)-[0-9]{4,}$"},
    "state": {"enum": ["empty", "proposed"]},
    "provenance": {"type": "string", "pattern": "^(owner|proposal|extracted:.+|reference:.+)$"},
    "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "text": {"type": "string", "minLength": 1},
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "provenance"],
      "properties": {
        "state": {"$ref": "#/$defs/state"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "label": {"$ref": "#/$defs/text"},
        "situation": {"$ref": "#/$defs/text"},
        "knows": {"$ref": "#/$defs/text"},
        "decides": {"$ref": "#/$defs/text"},
        "next_action": {"$ref": "#/$defs/text"}
      },
      "if": {"properties": {"state": {"const": "proposed"}}},
      "then": {"required": ["situation", "knows", "decides", "next_action"]}
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "provenance"],
      "properties": {
        "state": {"$ref": "#/$defs/state"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "text": {"$ref": "#/$defs/text"},
        "audience": {"type": "string", "pattern": "^aud-[0-9]{4,}$"},
        "evidence_claims": {"type": "array", "items": {"type": "string", "pattern": "^clm-[0-9]{4,}$"}, "uniqueItems": true},
        "rank": {"type": "integer", "minimum": 1}
      },
      "if": {"properties": {"state": {"const": "proposed"}}},
      "then": {"required": ["text", "audience", "rank"]}
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "provenance"],
      "properties": {
        "state": {"$ref": "#/$defs/state"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "text": {"$ref": "#/$defs/text"},
        "role": {"enum": ["benefit", "proof", "how", "objection", "cta", "vision"]},
        "audience": {"type": "string", "pattern": "^aud-[0-9]{4,}$"},
        "addresses": {"type": "array", "items": {"type": "string", "pattern": "^prb-[0-9]{4,}$"}, "uniqueItems": true},
        "supports": {"type": "array", "items": {"type": "string", "pattern": "^clm-[0-9]{4,}$"}, "uniqueItems": true},
        "rank": {"type": "integer", "minimum": 1},
        "renditions": {"type": "object", "additionalProperties": {"$ref": "#/$defs/text"}}
      },
      "if": {"properties": {"state": {"const": "proposed"}}},
      "then": {"required": ["text", "role", "audience", "rank"]}
    },
    "claimValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "qualifier"],
      "properties": {
        "value": {"oneOf": [
          {"type": "number"},
          {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
        ]},
        "unit": {"type": "string"},
        "qualifier": {"type": "array", "uniqueItems": true, "items": {"enum": ["gte", "gt", "lte", "lt", "approx", "max", "min", "tax_in", "tax_ex", "monthly", "yearly", "plus"]}}
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "provenance"],
      "properties": {
        "state": {"$ref": "#/$defs/state"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "kind": {"enum": ["number", "price", "social_proof", "comparative", "superlative", "fact"]},
        "statement": {"$ref": "#/$defs/text"},
        "value": {"$ref": "#/$defs/claimValue"},
        "variants": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "evidence": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["source"],
          "properties": {"source": {"$ref": "#/$defs/text"}, "note": {"type": "string"}}
        }},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["audiences", "as_of"],
          "properties": {
            "audiences": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^aud-[0-9]{4,}$"}, "uniqueItems": true},
            "as_of": {"$ref": "#/$defs/date"},
            "population": {"type": "string"}
          }
        },
        "expires": {"$ref": "#/$defs/date"}
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "proposed"}}},
         "then": {"required": ["kind", "statement", "evidence", "scope"]}},
        {"if": {"properties": {"state": {"const": "proposed"}, "kind": {"enum": ["number", "price"]}}, "required": ["kind"]},
         "then": {"required": ["value"]}},
        {"if": {"properties": {"state": {"const": "proposed"}, "kind": {"enum": ["number", "price", "social_proof"]}}, "required": ["kind"]},
         "then": {"required": ["expires"]}}
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "provenance"],
      "properties": {
        "state": {"$ref": "#/$defs/state"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "type": {"enum": ["product", "feature", "case", "use_case", "alternative", "organization"]},
        "name": {"$ref": "#/$defs/text"},
        "forbidden": {"type": "array", "items": {"$ref": "#/$defs/text"}, "uniqueItems": true},
        "variant_folding": {"type": "boolean", "default": true}
      },
      "if": {"properties": {"state": {"const": "proposed"}}},
      "then": {"required": ["type", "name"]}
    }
  }
}

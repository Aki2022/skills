{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "own-infoarch-author/info_arch.v4.schema.json",
  "title": "design/info_arch/info_arch.yaml schema version 4 (positioning atoms and arrows + messaging SSOT)",
  "description": "伝え方の SSOT。positioning（SPEC-information-architecture-standardization v6 要件 2）の原子（セグメント・ジョブ・痛み・得たいもの・代替・カテゴリー・強み・提供価値・証拠）と矢印（edges）を持つ。原子は 1 つのセグメントにだけ属し（segment）、別のセグメントで使うときは写しを作って出どころ（copied_from）を書く。v5 の約束とカテゴリーとコンセプトは持たない。対象者・メッセージは outline へ移すまで（ISSUE-14）ここに残る。state に approved は無い：承認はハッシュ束縛の承認台帳（ia:positioning:<原子 id か矢印のキー>）が持つ。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ledger",
    "audiences",
    "messages",
    "proofs",
    "facts",
    "entities",
    "voices",
    "segments",
    "jobs",
    "pains",
    "gains",
    "values",
    "alternatives",
    "strengths",
    "categories",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": 4
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "next",
        "tombstones"
      ],
      "properties": {
        "next": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "aud",
            "msg",
            "prf",
            "fct",
            "ent",
            "vce",
            "seg",
            "job",
            "pan",
            "gan",
            "val",
            "alt",
            "str",
            "cat"
          ],
          "properties": {
            "aud": {
              "type": "integer",
              "minimum": 1
            },
            "msg": {
              "type": "integer",
              "minimum": 1
            },
            "prf": {
              "type": "integer",
              "minimum": 1
            },
            "fct": {
              "type": "integer",
              "minimum": 1
            },
            "ent": {
              "type": "integer",
              "minimum": 1
            },
            "vce": {
              "type": "integer",
              "minimum": 1
            },
            "seg": {
              "type": "integer",
              "minimum": 1
            },
            "job": {
              "type": "integer",
              "minimum": 1
            },
            "pan": {
              "type": "integer",
              "minimum": 1
            },
            "gan": {
              "type": "integer",
              "minimum": 1
            },
            "val": {
              "type": "integer",
              "minimum": 1
            },
            "alt": {
              "type": "integer",
              "minimum": 1
            },
            "str": {
              "type": "integer",
              "minimum": 1
            },
            "cat": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "tombstones": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/anyId"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/anyId"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expiry_days": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "proof": {
              "type": "integer",
              "minimum": 1
            },
            "fact": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "audiences": {
      "type": "object",
      "propertyNames": {
        "pattern": "^aud-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/audience"
      }
    },
    "messages": {
      "type": "object",
      "propertyNames": {
        "pattern": "^msg-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/message"
      }
    },
    "proofs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^prf-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/proof"
      }
    },
    "facts": {
      "type": "object",
      "propertyNames": {
        "pattern": "^fct-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/fact"
      }
    },
    "entities": {
      "type": "object",
      "propertyNames": {
        "pattern": "^ent-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/entity"
      }
    },
    "voices": {
      "type": "object",
      "propertyNames": {
        "pattern": "^vce-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/voice"
      }
    },
    "segments": {
      "type": "object",
      "propertyNames": {
        "pattern": "^seg-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/segment"
      }
    },
    "jobs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^job-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/job"
      }
    },
    "pains": {
      "type": "object",
      "propertyNames": {
        "pattern": "^pan-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/pain"
      }
    },
    "gains": {
      "type": "object",
      "propertyNames": {
        "pattern": "^gan-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/gain"
      }
    },
    "values": {
      "type": "object",
      "propertyNames": {
        "pattern": "^val-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/value"
      }
    },
    "alternatives": {
      "type": "object",
      "propertyNames": {
        "pattern": "^alt-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/alternative"
      }
    },
    "strengths": {
      "type": "object",
      "propertyNames": {
        "pattern": "^str-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/strength"
      }
    },
    "categories": {
      "type": "object",
      "propertyNames": {
        "pattern": "^cat-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/category"
      }
    },
    "edges": {
      "type": "array",
      "description": "矢印の並び。書いた順番は id に入らない。キーは <種類>:<始点>:<終点>（同じキーは 1 本だけ）",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "anyId": {
      "type": "string",
      "pattern": "^(aud|msg|prf|fct|ent|vce|seg|job|pan|gan|val|alt|str|cat)-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
    },
    "state": {
      "enum": [
        "empty",
        "proposed"
      ]
    },
    "provenance": {
      "type": "string",
      "pattern": "^(owner|proposal|extracted:.+|reference:.+)$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "situation": {
          "$ref": "#/$defs/text"
        },
        "pains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "desired_action": {
          "$ref": "#/$defs/text"
        },
        "tone": {
          "$ref": "#/$defs/text"
        },
        "priorities": {
          "allOf": [
            {
              "$ref": "#/$defs/ids"
            },
            {
              "items": {
                "pattern": "^msg-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
              }
            }
          ],
          "description": "この対象者に伝えるメッセージを優先順に並べる。先頭が 1 位"
        },
        "segment": {
          "type": "string",
          "pattern": "^seg-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "required": [
          "label",
          "situation",
          "desired_action",
          "priorities",
          "segment"
        ],
        "properties": {
          "priorities": {
            "minItems": 1
          }
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "role": {
          "enum": [
            "benefit",
            "proof",
            "how",
            "objection",
            "cta",
            "vision"
          ]
        },
        "addresses": {
          "allOf": [
            {
              "$ref": "#/$defs/ids"
            },
            {
              "items": {
                "pattern": "^pan-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
              }
            }
          ]
        },
        "serves": {
          "allOf": [
            {
              "$ref": "#/$defs/ids"
            },
            {
              "items": {
                "pattern": "^(val|job|pan|gan)-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
              }
            }
          ],
          "description": "このメッセージが立つ positioning の原子（ISSUE-14 で提供価値ちょうど 1 つに替わる）"
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "required": [
          "text",
          "role"
        ]
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "source": {
          "$ref": "#/$defs/text"
        },
        "supports": {
          "allOf": [
            {
              "$ref": "#/$defs/ids"
            },
            {
              "items": {
                "pattern": "^msg-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
              }
            }
          ],
          "description": "outline へ移すまでのメッセージの証拠（ISSUE-14 で positioning の経路から受け継ぐ形に替わる）"
        },
        "as_of": {
          "$ref": "#/$defs/date"
        },
        "expires": {
          "$ref": "#/$defs/date"
        },
        "segment": {
          "type": "string",
          "pattern": "^seg-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$",
          "description": "positioning の証拠のとき、属するセグメント。支える原子と矢印は edges の supports で結ぶ（メッセージの supports とは併記しない）"
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "required": [
          "text",
          "source"
        ],
        "allOf": [
          {
            "anyOf": [
              {
                "required": [
                  "as_of"
                ]
              },
              {
                "required": [
                  "expires"
                ]
              }
            ]
          },
          {
            "oneOf": [
              {
                "required": [
                  "supports"
                ],
                "not": {
                  "required": [
                    "segment"
                  ]
                }
              },
              {
                "required": [
                  "segment"
                ],
                "not": {
                  "required": [
                    "supports"
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "label": {
          "$ref": "#/$defs/text"
        },
        "value": {
          "$ref": "#/$defs/text"
        },
        "as_of": {
          "$ref": "#/$defs/date"
        },
        "expires": {
          "$ref": "#/$defs/date"
        },
        "evergreen": {
          "type": "boolean",
          "description": "連絡先・免責など、時点を持たない値は true"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "proposed"
              }
            }
          },
          "then": {
            "required": [
              "label",
              "value"
            ],
            "anyOf": [
              {
                "required": [
                  "as_of"
                ]
              },
              {
                "required": [
                  "expires"
                ]
              },
              {
                "required": [
                  "evergreen"
                ],
                "properties": {
                  "evergreen": {
                    "const": true
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "evergreen": {
                "const": true
              }
            },
            "required": [
              "evergreen"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "as_of"
                  ]
                },
                {
                  "required": [
                    "expires"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "type": {
          "enum": [
            "product",
            "feature",
            "organization",
            "service",
            "other"
          ]
        },
        "name": {
          "$ref": "#/$defs/text"
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "required": [
          "type",
          "name"
        ]
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "traits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trait",
              "is",
              "is_not"
            ],
            "properties": {
              "trait": {
                "$ref": "#/$defs/text"
              },
              "is": {
                "$ref": "#/$defs/text"
              },
              "is_not": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "required": [
          "traits"
        ],
        "properties": {
          "traits": {
            "minItems": 3,
            "maxItems": 4
          }
        }
      }
    },
    "segment": {
      "type": "object",
      "description": "セグメント：見分ける条件と、置かれている状況。払う人と使う人が違えば別のセグメント",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "qualifier": {
          "$ref": "#/$defs/text"
        },
        "situation": {
          "$ref": "#/$defs/text"
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "required": [
          "qualifier",
          "situation"
        ]
      }
    },
    "job": {
      "type": "object",
      "description": "ジョブ：セグメントが片付けたい用事（4 つの力は持たない。Deferred Q13）",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "segment": {
          "type": "string",
          "pattern": "^seg-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "copied_from": {
          "$ref": "#/$defs/anyId",
          "description": "写しの出どころ（別のセグメントの同じ種類の原子）。どの id にも入らない"
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "required": [
          "segment",
          "text"
        ]
      }
    },
    "pain": {
      "type": "object",
      "description": "痛み：ジョブの周りで顧客が感じる困りごと（重要度は持たない）",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "segment": {
          "type": "string",
          "pattern": "^seg-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "copied_from": {
          "$ref": "#/$defs/anyId",
          "description": "写しの出どころ（別のセグメントの同じ種類の原子）。どの id にも入らない"
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "required": [
          "segment",
          "text"
        ]
      }
    },
    "gain": {
      "type": "object",
      "description": "得たいもの：ジョブの周りで顧客が得たいこと（重要度は持たない）",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "segment": {
          "type": "string",
          "pattern": "^seg-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "copied_from": {
          "$ref": "#/$defs/anyId",
          "description": "写しの出どころ（別のセグメントの同じ種類の原子）。どの id にも入らない"
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "required": [
          "segment",
          "text"
        ]
      }
    },
    "value": {
      "type": "object",
      "description": "提供価値：顧客が得るもの。difference（違い）は隙間を、parity（同等）は同等であるべき点を満たす",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "segment": {
          "type": "string",
          "pattern": "^seg-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "copied_from": {
          "$ref": "#/$defs/anyId",
          "description": "写しの出どころ（別のセグメントの同じ種類の原子）。どの id にも入らない"
        },
        "kind": {
          "enum": [
            "difference",
            "parity"
          ]
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "required": [
          "segment",
          "text",
          "kind"
        ]
      }
    },
    "alternative": {
      "type": "object",
      "description": "代替：顧客がほかに選べるもの（競合・今の対策・何もしない）",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "segment": {
          "type": "string",
          "pattern": "^seg-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "copied_from": {
          "$ref": "#/$defs/anyId",
          "description": "写しの出どころ（別のセグメントの同じ種類の原子）。どの id にも入らない"
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "required": [
          "segment",
          "text"
        ]
      }
    },
    "strength": {
      "type": "object",
      "description": "強み：代替に無い、こちらだけの能力",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "segment": {
          "type": "string",
          "pattern": "^seg-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "copied_from": {
          "$ref": "#/$defs/anyId",
          "description": "写しの出どころ（別のセグメントの同じ種類の原子）。どの id にも入らない"
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "required": [
          "segment",
          "text"
        ]
      }
    },
    "category": {
      "type": "object",
      "description": "カテゴリー：顧客が解決策を分類して比べる枠（顧客の側の認知）",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "segment": {
          "type": "string",
          "pattern": "^seg-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "copied_from": {
          "$ref": "#/$defs/anyId",
          "description": "写しの出どころ（別のセグメントの同じ種類の原子）。どの id にも入らない"
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "required": [
          "segment",
          "text"
        ]
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "from",
        "to",
        "state",
        "provenance"
      ],
      "description": "矢印。種類ごとの始点と終点の原子の種類、度合いの有無は check が確かめる（要件 2）",
      "properties": {
        "kind": {
          "enum": [
            "has_job",
            "need",
            "fulfills",
            "recalls",
            "includes",
            "member_of",
            "lacks",
            "produces",
            "satisfies",
            "supports"
          ]
        },
        "from": {
          "$ref": "#/$defs/anyId"
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "description": "原子の id。supports だけは矢印のキー（<種類>:<始点>:<終点>）も指せる"
        },
        "degree": {
          "enum": [
            "full",
            "partial",
            "none"
          ],
          "description": "fulfills（代替→痛み・得たいもの）の満たす度合い。ほかの種類には書かない"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "copied_from": {
          "type": "string",
          "minLength": 1,
          "description": "写しの出どころの矢印のキー。どの id にも入らない"
        }
      }
    }
  }
}

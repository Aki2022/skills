{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "own-infoarch-author/outline.v1.schema.json",
  "title": "design/info_arch/outlines/<artifact id>.yaml schema version 1 (structured outline)",
  "description": "成果物ごとの構造化アウトライン。6 段の結果を書く。AI が書き、人は保守しない。固定値は文案の中で {{fct-NNNN}} として参照し、値を直接書かない。出典: SPEC-information-architecture-standardization v4。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "channel", "brief", "audience", "outputs", "pages"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "channel": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "brief": {
      "type": "object", "additionalProperties": false, "required": ["purpose", "action", "medium"],
      "properties": {
        "purpose": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "medium": {"type": "string", "minLength": 1},
        "constraints": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "cut": {"type": "array", "items": {"type": "string", "pattern": "^msg-(?:[0-9]{4}|[1-9][0-9]{4,})$"}, "uniqueItems": true,
                "description": "この成果物では言わないと決めたメッセージ（段 3 の削る判断）"}
      }
    },
    "audience": {"type": "string", "pattern": "^aud-(?:[0-9]{4}|[1-9][0-9]{4,})$"},
    "outputs": {"type": "array", "minItems": 1, "uniqueItems": true,
                "items": {"type": "string", "minLength": 1, "not": {"pattern": "^(/|~)|(^|/)\\.\\.(/|$)"}}},
    "pages": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "sections"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "label": {"type": "string", "minLength": 1},
        "sections": {"type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false, "required": ["role", "copy"],
          "properties": {
            "role": {"enum": ["problem", "benefit", "proof", "how", "objection", "cta", "vision", "navigation", "other"]},
            "message": {"type": "string", "pattern": "^msg-(?:[0-9]{4}|[1-9][0-9]{4,})$"},
            "problem": {"type": "string", "pattern": "^prb-(?:[0-9]{4}|[1-9][0-9]{4,})$"},
            "proofs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^prf-(?:[0-9]{4}|[1-9][0-9]{4,})$"}},
            "copy": {"type": "string", "minLength": 1}
          }
        }}
      }
    }}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "own-infoarch-author/script.v1.schema.json",
  "title": "ux/infoarch/scripts/<deliverable id>.yaml schema version 1 (script, 台本)",
  "description": "台本（SPEC-information-architecture-standardization 要件 6、SPEC-deliverable-production-layers 要件 16〜20）。outline（版 3）を置き換える。positioning 1 つ（target のセグメント）に立ち、定数（target・touchpoint・tone）と目的変数（objective）を置いて、独立変数のメッセージ・まとまり・文案を組み立てる。まとまりは内容の働き（辞書の 7 つ）を 1 つ持つ。1 ページ＝1 台本。AI が作り、人は保守しない。並びは order で持ち、ファイルの中で書いた順番は意味を持たない。id・channel・outputs は置き場所の宣言で、台本の id に入らない。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "channel",
    "outputs",
    "target",
    "touchpoint",
    "tone",
    "objective",
    "messages",
    "blocks",
    "copies"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "channel": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {
          "pattern": "^(/|~)|(^|/)\\.\\.(/|$)"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment",
        "condition"
      ],
      "description": "意図した相手：セグメント（id）＋足す条件。台本はこのセグメントの positioning に立つ",
      "properties": {
        "segment": {
          "type": "string",
          "pattern": "^seg-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "touchpoint": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "description": "接点（lp・ad・flyer・deck など）"
    },
    "tone": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "action"
      ],
      "description": "目的変数：取ってほしい行動。CTA のメッセージが achieves で指す",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^obj-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
        },
        "action": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "no_cta": {
      "type": "boolean",
      "description": "CTA を置かない宣言（true のときだけ書く）。報告に「CTA なし（意図）」を出す"
    },
    "messages": {
      "type": "object",
      "propertyNames": {
        "pattern": "^msg-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/message"
      }
    },
    "blocks": {
      "type": "object",
      "propertyNames": {
        "pattern": "^blk-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/block"
      }
    },
    "copies": {
      "type": "object",
      "propertyNames": {
        "pattern": "^cpy-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/copy"
      }
    },
    "texts": {
      "type": "object",
      "description": "主張でない文言の宣言（ナビ・見出しのラベル。D12）。key は台本の中で一意",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/text_decl"
      }
    }
  },
  "$defs": {
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "rank",
        "type"
      ],
      "description": "何を言うか。提供価値をちょうど 1 つ指す（CTA も、その行動で何が得られるかとして指す）。主張と行動のまとまりにだけ置く",
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^val-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
        },
        "rank": {
          "enum": [
            "lead",
            "support"
          ]
        },
        "type": {
          "enum": [
            "normal",
            "cta"
          ]
        },
        "compares": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^alt-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
          },
          "description": "比べる代替（0 個以上）"
        },
        "achieves": {
          "type": "string",
          "pattern": "^obj-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
        }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order",
        "function"
      ],
      "description": "どこで何番目に言うか（まとまり）。内容の働きを辞書の 7 つ（term-function-*）から 1 つ持つ。主張のまとまりは通常のメッセージをちょうど 1 つ、行動のまとまりは CTA を 0〜1 つ置く。ほかの働きのまとまりはメッセージを置かない",
      "properties": {
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "function": {
          "enum": [
            "identify",
            "claim",
            "fact",
            "evidence",
            "offer",
            "action",
            "source"
          ],
          "description": "名乗り・主張・事実・証拠と声・提供条件・行動・出典と運営者"
        },
        "places": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block",
        "order",
        "text"
      ],
      "description": "どんな言葉で言うか（文案）。まとまりに属し、まとまりの中の順番を持つ。引き先（伝えるメッセージ・positioning の証拠・辞書の値 {{value-<辞書の id>}}）を持つか、提案の印（proposal: true）を持つ",
      "properties": {
        "block": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "description": "伝えるメッセージ。同じまとまりに置かれたものだけ"
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^prf-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
          },
          "description": "引く positioning の証拠（事実・証拠と声の文案）"
        },
        "proposal": {
          "const": true,
          "description": "提案の印：引き先の無い文（true のときだけ書く）。制作中は警告、出荷で止める"
        }
      }
    },
    "text_decl": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "enum": [
            "navigation",
            "label"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "block": {
          "type": "string",
          "description": "label を置くまとまり"
        }
      }
    }
  }
}

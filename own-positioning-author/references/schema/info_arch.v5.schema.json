{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "own-positioning-author/info_arch.v5.schema.json",
  "title": "design/info_arch/info_arch.yaml schema version 5 (positioning: atoms, arrows and evidence)",
  "description": "positioning（なぜ・誰に・何を）の正典。セグメント・ジョブ・痛み・得たいもの・代替・カテゴリー・強み・提供価値・証拠と、それらを結ぶ矢印。正式名称と固定値は docs/dictionary/ の辞書が持ち、ここには書かない（SPEC-deliverable-production-layers 要件 9）。声は廃止した（要件 8）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ledger",
    "proofs",
    "segments",
    "jobs",
    "pains",
    "gains",
    "values",
    "alternatives",
    "strengths",
    "categories",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": 5
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "next",
        "tombstones"
      ],
      "properties": {
        "next": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prf",
            "seg",
            "job",
            "pan",
            "gan",
            "val",
            "alt",
            "str",
            "cat"
          ],
          "properties": {
            "prf": {
              "type": "integer",
              "minimum": 1
            },
            "seg": {
              "type": "integer",
              "minimum": 1
            },
            "job": {
              "type": "integer",
              "minimum": 1
            },
            "pan": {
              "type": "integer",
              "minimum": 1
            },
            "gan": {
              "type": "integer",
              "minimum": 1
            },
            "val": {
              "type": "integer",
              "minimum": 1
            },
            "alt": {
              "type": "integer",
              "minimum": 1
            },
            "str": {
              "type": "integer",
              "minimum": 1
            },
            "cat": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "tombstones": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/anyId"
          },
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/anyId"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expiry_days": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "proof": {
              "type": "integer",
              "minimum": 1
            },
            "fact": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "proofs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^prf-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/proof"
      }
    },
    "segments": {
      "type": "object",
      "propertyNames": {
        "pattern": "^seg-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/segment"
      }
    },
    "jobs": {
      "type": "object",
      "propertyNames": {
        "pattern": "^job-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/job"
      }
    },
    "pains": {
      "type": "object",
      "propertyNames": {
        "pattern": "^pan-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/pain"
      }
    },
    "gains": {
      "type": "object",
      "propertyNames": {
        "pattern": "^gan-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/gain"
      }
    },
    "values": {
      "type": "object",
      "propertyNames": {
        "pattern": "^val-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/value"
      }
    },
    "alternatives": {
      "type": "object",
      "propertyNames": {
        "pattern": "^alt-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/alternative"
      }
    },
    "strengths": {
      "type": "object",
      "propertyNames": {
        "pattern": "^str-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/strength"
      }
    },
    "categories": {
      "type": "object",
      "propertyNames": {
        "pattern": "^cat-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/category"
      }
    },
    "edges": {
      "type": "array",
      "description": "矢印の並び。書いた順番は id に入らない。キーは <種類>:<始点>:<終点>（同じキーは 1 本だけ）",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "anyId": {
      "type": "string",
      "pattern": "^(prf|seg|job|pan|gan|val|alt|str|cat)-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
    },
    "state": {
      "enum": [
        "empty",
        "proposed"
      ]
    },
    "provenance": {
      "type": "string",
      "pattern": "^(owner|proposal|extracted:.+|reference:.+)$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "source": {
          "$ref": "#/$defs/text"
        },
        "as_of": {
          "$ref": "#/$defs/date"
        },
        "expires": {
          "$ref": "#/$defs/date"
        },
        "segment": {
          "type": "string",
          "pattern": "^seg-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$",
          "description": "属するセグメント。支える原子と矢印は edges の supports で結ぶ（outline のメッセージは、指した提供価値の経路の証拠を受け継ぐ）"
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "required": [
          "text",
          "source",
          "segment"
        ],
        "anyOf": [
          {
            "required": [
              "as_of"
            ]
          },
          {
            "required": [
              "expires"
            ]
          }
        ]
      }
    },
    "segment": {
      "type": "object",
      "description": "セグメント：見分ける条件と、置かれている状況。払う人と使う人が違えば別のセグメント",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "qualifier": {
          "$ref": "#/$defs/text"
        },
        "situation": {
          "$ref": "#/$defs/text"
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "required": [
          "qualifier",
          "situation"
        ]
      }
    },
    "job": {
      "type": "object",
      "description": "ジョブ：セグメントが片付けたい用事（4 つの力は持たない。Deferred Q13）",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "segment": {
          "type": "string",
          "pattern": "^seg-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "copied_from": {
          "$ref": "#/$defs/anyId",
          "description": "写しの出どころ（別のセグメントの同じ種類の原子）。どの id にも入らない"
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "required": [
          "segment",
          "text"
        ]
      }
    },
    "pain": {
      "type": "object",
      "description": "痛み：ジョブの周りで顧客が感じる困りごと（重要度は持たない）",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "segment": {
          "type": "string",
          "pattern": "^seg-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "copied_from": {
          "$ref": "#/$defs/anyId",
          "description": "写しの出どころ（別のセグメントの同じ種類の原子）。どの id にも入らない"
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "required": [
          "segment",
          "text"
        ]
      }
    },
    "gain": {
      "type": "object",
      "description": "得たいもの：ジョブの周りで顧客が得たいこと（重要度は持たない）",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "segment": {
          "type": "string",
          "pattern": "^seg-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "copied_from": {
          "$ref": "#/$defs/anyId",
          "description": "写しの出どころ（別のセグメントの同じ種類の原子）。どの id にも入らない"
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "required": [
          "segment",
          "text"
        ]
      }
    },
    "value": {
      "type": "object",
      "description": "提供価値：顧客が得るもの。difference（違い）は隙間を、parity（同等）は同等であるべき点を満たす",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "segment": {
          "type": "string",
          "pattern": "^seg-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "copied_from": {
          "$ref": "#/$defs/anyId",
          "description": "写しの出どころ（別のセグメントの同じ種類の原子）。どの id にも入らない"
        },
        "kind": {
          "enum": [
            "difference",
            "parity"
          ]
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "required": [
          "segment",
          "text",
          "kind"
        ]
      }
    },
    "alternative": {
      "type": "object",
      "description": "代替：顧客がほかに選べるもの（競合・今の対策・何もしない）",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "segment": {
          "type": "string",
          "pattern": "^seg-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "copied_from": {
          "$ref": "#/$defs/anyId",
          "description": "写しの出どころ（別のセグメントの同じ種類の原子）。どの id にも入らない"
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "required": [
          "segment",
          "text"
        ]
      }
    },
    "strength": {
      "type": "object",
      "description": "強み：代替に無い、こちらだけの能力",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "segment": {
          "type": "string",
          "pattern": "^seg-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "copied_from": {
          "$ref": "#/$defs/anyId",
          "description": "写しの出どころ（別のセグメントの同じ種類の原子）。どの id にも入らない"
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "required": [
          "segment",
          "text"
        ]
      }
    },
    "category": {
      "type": "object",
      "description": "カテゴリー：顧客が解決策を分類して比べる枠（顧客の側の認知）",
      "additionalProperties": false,
      "required": [
        "state",
        "provenance"
      ],
      "properties": {
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "segment": {
          "type": "string",
          "pattern": "^seg-(?:(?!0000)[0-9]{4}|[1-9][0-9]{4,})$"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "copied_from": {
          "$ref": "#/$defs/anyId",
          "description": "写しの出どころ（別のセグメントの同じ種類の原子）。どの id にも入らない"
        }
      },
      "if": {
        "properties": {
          "state": {
            "const": "proposed"
          }
        }
      },
      "then": {
        "required": [
          "segment",
          "text"
        ]
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "from",
        "to",
        "state",
        "provenance"
      ],
      "description": "矢印。種類ごとの始点と終点の原子の種類、度合いの有無は check が確かめる（要件 2）",
      "properties": {
        "kind": {
          "enum": [
            "has_job",
            "need",
            "fulfills",
            "recalls",
            "includes",
            "member_of",
            "lacks",
            "produces",
            "satisfies",
            "supports"
          ]
        },
        "from": {
          "$ref": "#/$defs/anyId"
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "description": "原子の id。supports だけは矢印のキー（<種類>:<始点>:<終点>）も指せる"
        },
        "degree": {
          "enum": [
            "full",
            "partial",
            "none"
          ],
          "description": "fulfills（代替→痛み・得たいもの）の満たす度合い。ほかの種類には書かない"
        },
        "state": {
          "$ref": "#/$defs/state"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "copied_from": {
          "type": "string",
          "minLength": 1,
          "description": "写しの出どころの矢印のキー。どの id にも入らない"
        }
      }
    }
  }
}
